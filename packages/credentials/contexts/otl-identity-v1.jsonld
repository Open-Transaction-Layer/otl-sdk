{
  "@context": {
    "@protected": true,
    "otl": "https://www.otl.network/ns/identity#",

    "OtlLeiCredential": "otl:OtlLeiCredential",
    "OtlHostingCredential": "otl:OtlHostingCredential",

    "commonName": "otl:commonName",
    "watchers": { "@id": "otl:watcher", "@type": "@id", "@container": "@set" },

    "lei": "otl:lei",

    "entity": {
      "@id": "otl:entity",
      "@context": {
        "@protected": true,
        "legalName": "otl:legalName",
        "otherNames": { "@id": "otl:otherName", "@container": "@set" },
        "legalAddress": "otl:legalAddress",
        "headquartersAddress": "otl:headquartersAddress",
        "registeredAt": {
          "@id": "otl:registeredAt",
          "@context": { "@protected": true, "id": "otl:registrationAuthorityCode" }
        },
        "registeredAs": "otl:registeredAs",
        "jurisdiction": "otl:jurisdiction",
        "legalForm": {
          "@id": "otl:legalForm",
          "@context": { "@protected": true, "id": "otl:elfCode" }
        },
        "category": "otl:category",
        "addressLines": { "@id": "otl:addressLines", "@container": "@list" },
        "city": "otl:city",
        "region": "otl:region",
        "country": "otl:country",
        "postalCode": "otl:postalCode"
      }
    },

    "registration": {
      "@id": "otl:registration",
      "@context": {
        "@protected": true,
        "initialRegistrationDate": { "@id": "otl:initialRegistrationDate", "@type": "http://www.w3.org/2001/XMLSchema#dateTime" },
        "nextRenewalDate": { "@id": "otl:nextRenewalDate", "@type": "http://www.w3.org/2001/XMLSchema#dateTime" },
        "managingLou": "otl:managingLou",
        "corroborationLevel": "otl:corroborationLevel"
      }
    }
  }
}
