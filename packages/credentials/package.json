{
  "name": "@open-transaction-layer/credentials",
  "version": "0.2.0",
  "type": "module",
  "description": "OTL verifiable credentials: pluggable credential-type registry, LEI/LOU instance, trust perimeter and validation chain.",
  "exports": {
    ".": {
      "otl-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "otl-source": "./src/context.ts",
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./contexts/otl-identity-v1.jsonld": "./contexts/otl-identity-v1.jsonld"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@open-transaction-layer/core": "0.2.0",
    "@open-transaction-layer/keys": "0.2.0"
  },
  "devDependencies": {
    "@open-transaction-layer/keys-dev": "0.2.0",
    "jsonld": "9.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "contexts",
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Transaction-Layer/otl-sdk.git",
    "directory": "packages/credentials"
  },
  "homepage": "https://github.com/Open-Transaction-Layer/otl-sdk/tree/main/packages/credentials#readme",
  "bugs": {
    "url": "https://github.com/Open-Transaction-Layer/otl-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
