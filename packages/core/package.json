{
  "name": "@open-transaction-layer/core",
  "version": "0.1.0",
  "type": "module",
  "description": "OTL Identity layer protocol core: JCS canonicalization, Data Integrity proofs, did:webvh, credentials.",
  "exports": {
    ".": {
      "otl-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./didwebvh": {
      "otl-source": "./src/didwebvh/index.ts",
      "types": "./dist/didwebvh/index.d.ts",
      "default": "./dist/didwebvh/index.js"
    },
    "./statuslist": {
      "otl-source": "./src/statuslist/index.ts",
      "types": "./dist/statuslist/index.d.ts",
      "default": "./dist/statuslist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@open-transaction-layer/keys": "0.1.0"
  },
  "devDependencies": {
    "@digitalbazaar/data-integrity": "2.5.0",
    "@digitalbazaar/ed25519-multikey": "1.3.1",
    "@digitalbazaar/eddsa-jcs-2022-cryptosuite": "1.0.0",
    "@open-transaction-layer/keys-dev": "0.1.0",
    "didwebvh-ts": "3.2.0",
    "jsonld": "9.0.0",
    "jsonld-signatures": "11.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Transaction-Layer/otl-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Open-Transaction-Layer/otl-sdk/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Open-Transaction-Layer/otl-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
